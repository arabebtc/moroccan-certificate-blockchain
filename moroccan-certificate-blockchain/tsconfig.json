{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@mcb/shared/*": ["./packages/shared/src/*"],
      "@mcb/consensus/*": ["./packages/consensus/src/*"]
    }
  },
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/consensus" },
    { "path": "./apps/node" }
  ]
}
